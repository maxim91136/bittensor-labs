# CSP: das Inline-Skript (YouTube-Klick) ist per Hash erlaubt. Wird es geändert, Hash neu berechnen (sha256, base64).
# Cloudflare Web Analytics (Beacon) ist von Cloudflare eingefügt und deshalb erlaubt.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-cN5OarjJVsVJcR/R5lnVzw/C4alEJiykSIePRkIVOyg='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.coingecko.com https://data-api.binance.vision https://entrypoint-finney.opentensor.ai; frame-src https://taotensorlaw.com https://www.youtube-nocookie.com; base-uri 'self'; form-action 'none'; object-src 'none'; frame-ancestors 'none'

/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: *
  Cache-Control: public, max-age=30, s-maxage=60
*/